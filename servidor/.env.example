# Copia este archivo como .env (en la carpeta servidor/) y rellena los valores.
# El archivo .env NUNCA se sube al repositorio.

# desarrollo | produccion
ENTORNO=desarrollo
# Dirección pública de la web, sin barra final (en producción: https://exploryaa.com)
URL_PUBLICA=http://localhost:8000
# Solo si la web se sirve desde otro dominio que la API (separados por comas)
ORIGENES_PERMITIDOS=
