# Copia este archivo como ".env" y rellena tus claves.
# Si una clave está vacía, esa herramienta funciona en MODO PRUEBA (datos de ejemplo).

# Cerebro del agente (console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Vuelos (app.duffel.com -> Developers -> Access tokens; empieza con duffel_test_)
DUFFEL_TOKEN=

# Alojamientos (dashboard de liteapi.travel; la de pruebas empieza con sand_)
LITEAPI_KEY=

# Experiencias (Viator Partner -> API key de afiliado)
VIATOR_API_KEY=

# Moneda y nacionalidad por defecto
MONEDA=EUR
NACIONALIDAD=ES

# Pon 1 para forzar datos de ejemplo aunque tengas claves
MODO_PRUEBA=0

# --- Asistente de WhatsApp (Meta WhatsApp Cloud API) ---
# developers.facebook.com -> tu app -> WhatsApp -> Configuración de la API
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# Palabra secreta que inventas tú y pegas también en Meta al configurar el webhook
WA_VERIFY_TOKEN=
# Configuración de la app -> Básica -> Clave secreta de la app
WA_APP_SECRET=
WA_GRAPH_VERSION=v23.0
# Tu WhatsApp personal (solo dígitos, con prefijo): recibe avisos y envía comandos
ASESORA_WHATSAPP=
ASESORA_NOMBRE=
WA_DB=whatsapp.db
# 1 = el asistente puede buscar en internet recomendaciones en destino
WA_BUSQUEDA_WEB=1
